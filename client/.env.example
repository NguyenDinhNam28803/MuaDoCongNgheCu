# Sao chép thành .env rồi chỉnh theo môi trường
DATABASE_URL="postgresql://muaban:muaban@localhost:5434/muaban?schema=public"

# Chỉ dùng cho test tích hợp (pnpm test:db)
TEST_DATABASE_URL="postgresql://muaban:muaban@localhost:5434/muaban_test?schema=public"

# Kho ảnh S3-compatible. Dev: SeaweedFS trong docker-compose (pnpm db:up && pnpm storage:init).
# Production: Cloudflare R2 (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto,
# S3_FORCE_PATH_STYLE=false, S3_PUBLIC_BASE_URL = domain công khai của bucket public).
S3_ENDPOINT="http://localhost:8333"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="muaban"
S3_SECRET_ACCESS_KEY="muaban-secret"
S3_PUBLIC_BUCKET="muaban-public"
S3_PRIVATE_BUCKET="muaban-private"
S3_PUBLIC_BASE_URL="http://localhost:8333/muaban-public"
S3_FORCE_PATH_STYLE="true"

# Origin web được phép PUT ảnh lên bucket (pnpm storage:init áp CORS)
S3_CORS_ORIGINS="http://localhost:3000,http://localhost:3100"

# URL tuyệt đối của website (sitemap, SEO). Production: https://<tên miền>
SITE_URL="http://localhost:3000"
